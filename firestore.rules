
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isManager() {
      return isAuthenticated()
        && request.auth.token.role == 'ADMIN';
    }

    function canManageStaff() {
      return isSuperAdmin() || isManager();
    }

    function validStaff(data) {
      return data.keys().hasAll([
          'fullName',
          'email',
          'phone',
          'department',
          'title',
          'role',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'fullName',
          'email',
          'phone',
          'department',
          'title',
          'role',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches(
          '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'
        )
        && data.phone is string
        && data.phone.matches(
          '^(0[35789][0-9]{8}|\\+?84[35789][0-9]{8})$'
        )
        && data.department in [
          'Product',
          'Engineering',
          'Helpdesk',
          'UI/UX Design'
        ]
        && data.title in [
          'Frontend Developer',
          'Backend Developer',
          'Product Manager',
          'IT Support Engineer',
          'UI/UX Researcher',
          'UX Designer'
        ]
        && data.role in [
          'SUPER_ADMIN',
          'ADMIN',
          'STAFF'
        ]
        && data.status is bool
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    match /staffs/{staffId} {
      allow read: if canManageStaff();

      allow create: if canManageStaff()
        && validStaff(request.resource.data)
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && (
          request.resource.data.role != 'SUPER_ADMIN'
          || isSuperAdmin()
        );

      allow update: if canManageStaff()
        && validStaff(request.resource.data)
        && request.resource.data.created_at
          == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && (
          request.resource.data.role == resource.data.role
          || isSuperAdmin()
        );

      allow delete: if canManageStaff();
    }

    function validAuditLog(data) {
      return data.keys().hasAll([
          'user',
          'action',
          'target',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'user',
          'action',
          'target',
          'status',
          'createdAt'
        ])
        && data.user is string
        && data.user.size() >= 1
        && data.user.size() <= 100
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 150
        && data.target is string
        && data.target.size() <= 200
        && data.status in [
          'Success',
          'Pending',
          'Failed'
        ]
        && data.createdAt is timestamp;
    }

    match /audit_logs/{logId} {
      allow read, list: if canManageStaff();

      allow create: if canManageStaff()
        && validAuditLog(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /metrics/{metricId} {
      allow create: if isAuthenticated();
      allow read, list: if canManageStaff();
      allow update, delete: if false;
    }
  }
}
